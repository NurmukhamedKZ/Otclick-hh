# The ONLY env file. Copy to .env in the repo root:  cp .env.example .env
#
# It feeds everything at once:
#   * docker compose ${...} substitutions (Postgres/JWT keys, frontend build args)
#   * the api/worker containers (env_file: .env)
#   * `cd backend && uvicorn app.main:app --reload` (config.py also reads ../.env)
#
# Setup: `python3 infra/bootstrap.py` writes .env from this file with every
# secret generated and pasted into all the slots that must agree (one ANON_KEY
# in three vars, one SERVICE_ROLE_KEY in two, both signed by JWT_SECRET — a key
# signed by a different secret means blanket 401s). Filling it by hand works
# too; `infra/supabase/gen-keys.py` prints just the JWT triple.

# ─── Supabase stack (read by db/auth/rest/realtime/storage/kong) ───
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Single-user self-hosting: public sign-up stays closed. install.sh creates the
# first user through the service-role admin endpoint and stores only its UUID
# and login email here (never the password).
DISABLE_SIGNUP=true
OTCLICK_USER_ID=
OTCLICK_ADMIN_EMAIL=admin@otclick.local

# Caddy public listener. `:80` serves plain HTTP on all container interfaces.
# install.sh changes this to a DNS name when OTCLICK_DOMAIN/https is configured,
# which enables Caddy automatic HTTPS.
OTCLICK_PROXY_MODE=auto
CADDY_SITE_ADDRESS=:80
CADDY_HTTP_BIND=80
CADDY_HTTPS_BIND=443

# Incremental application image transport. Release is the production default:
# it downloads only the changed backend/frontend .tar.zst component over the
# GitHub Release CDN, then verifies SHA-256 and docker-loads it. GHCR stays as
# the immutable fallback. Set ghcr to force Docker registry layer pulls.
OTCLICK_IMAGE_TRANSPORT=release

# ─── Backend app ───
# In-network gateway hostname. Browser traffic reaches the same Kong service via
# Caddy, while containers use this private Docker-network URL directly.
SUPABASE_URL=http://kong:8000
# Browser-reachable URL of the same stack — signed captcha-screenshot links.
SUPABASE_PUBLIC_URL=http://localhost
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts hh tokens/cookies at rest. Generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated allowed browser origins. install.sh sets this to the public
# app origin. For direct local docker compose the Caddy origin is localhost.
CORS_ORIGINS=http://localhost
LOG_LEVEL=INFO
# Mounts /api/_debug/* — keep false outside local dev.
DEBUG_ENDPOINTS=false

# Hard kill switch for real vacancy submissions. Leave false during discovery,
# scoring, UI development and calibration. The send queue additionally requires
# an explicitly approved exact-text job before a response may reach HH.
ALLOW_REAL_APPLY=false

# ─── Frontend (baked into the image at build time) ───
# Caddy exposes frontend, FastAPI and Supabase on one browser origin.
NEXT_PUBLIC_SUPABASE_URL=http://localhost
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Google OAuth login — optional, off by default ───
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Internal cron — shared secret for /internal/cron/* (hh token refresh) ───
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CRON_TOKEN=
# Refresh hh creds expiring within this many days (refresh token is single-use).
REFRESH_THRESHOLD_DAYS=2

# ─── OpenAI-compatible LLM ───
# Used by scoring, cover letters, rule proposals, form answers and recruiter
# replies. The provider does NOT have to be OpenAI. install.sh can configure
# OpenCode Go / LongCat 2.0, LongCat direct, or any compatible base URL/model.
# Empty key is allowed only when AI features are intentionally disabled:
# discovery/review still work, while scoring/cover generation fail visibly.
OPENAI_API_KEY=
# Base URL only, not /chat/completions. Examples:
#   OpenCode Go: https://opencode.ai/zen/go/v1  + model longcat-2.0
#   LongCat:     https://api.longcat.chat/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RATE_LIMIT=60
# Portable default for OpenAI-compatible providers. Use json_schema only when
# the selected provider explicitly supports OpenAI Structured Outputs.
OPENAI_STRUCTURED_OUTPUT_METHOD=function_calling

# Positioning tactics baked into AI-generated candidate-facing text (recruiter
# chat, vacancy-test answers, cover letters, extension autofill/chat).
# "balanced" (default) never inflates experience/age/education and only uses
# negotiation framing the candidate could actually stand behind. "full" adds
# the guide's more aggressive tactics (experience/age/education padding,
# phantom-offer social proof) — opt in at your own risk, see AUDIT.md.
AI_POSITIONING=balanced

# ─── hh.ru OAuth client — legacy compatibility only ───
# Applicant OAuth/Bearer access is not a dependency of the new vacancy funnel.
# Discovery/enrichment use the authenticated hh.ru web session/cookies. Keep
# these unset unless a separately verified API use case needs an OAuth client.
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_REDIRECT_URI=

# ─── LangSmith tracing — OFF by default on purpose ───
# Enabling it ships resumes, recruiter chats and test answers to a third party.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Otclick
