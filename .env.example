# The ONLY env file. Copy to .env in the repo root:  cp .env.example .env
#
# It feeds everything at once:
#   * docker compose ${...} substitutions (Postgres/JWT keys, frontend build args)
#   * the api/worker containers (env_file: .env)
#   * `cd backend && uvicorn app.main:app --reload` (config.py also reads ../.env)
#
# Setup: `python3 infra/bootstrap.py` writes .env from this file with every
# secret generated and pasted into all the slots that must agree (one ANON_KEY
# in three vars, one SERVICE_ROLE_KEY in two, both signed by JWT_SECRET — a key
# signed by a different secret means blanket 401s). Filling it by hand works
# too; `infra/supabase/gen-keys.py` prints just the JWT triple.

# ─── Supabase stack (read by db/auth/rest/realtime/storage/kong) ───
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ─── Backend app ───
# In-network gateway hostname. For a non-local deploy point both at your own
# public Supabase gateway (SUPABASE_URL may stay internal, PUBLIC must not).
SUPABASE_URL=http://kong:8000
# Browser-reachable URL of the same stack — signed captcha-screenshot links.
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts hh tokens/cookies at rest. Generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated allowed browser origins. In production put your real domain
# here (https://app.example.com) — not localhost.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Mounts /api/_debug/* — keep false outside local dev.
DEBUG_ENDPOINTS=false

# ─── Frontend (baked into the image at build time) ───
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The FastAPI backend, NOT the Supabase gateway on 54321.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Google OAuth login — optional, off by default ───
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Internal cron — shared secret for /internal/cron/* (hh token refresh) ───
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CRON_TOKEN=
# Refresh hh creds expiring within this many days (refresh token is single-use).
REFRESH_THRESHOLD_DAYS=2

# ─── OpenAI — cover letters, form answers, recruiter replies ───
# Empty key → template fallbacks, nothing crashes.
OPENAI_API_KEY=
# Base URL, not a full endpoint path (/v1, not /v1/chat/completions).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_RATE_LIMIT=60

# ─── Billing / free tier ───
# BILLING_ENABLED=false (default) = no paywall at all: no apply caps, autonomous
# mode for everyone. That is the self-host setup — leave it off unless you are
# actually selling subscriptions, otherwise your own instance is capped at
# FREE_TOTAL_APPLIES.
BILLING_ENABLED=false
FREE_TOTAL_APPLIES=30     # lifetime cap for the free tier, not per day
PAID_DAILY_APPLIES=100    # daily cap once a plan is active

# ─── Polar.sh billing — optional for self-hosting ───
# Merchant of record. Prices and intervals live in the Polar products, not here.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=          # from the webhook endpoint in the Polar dashboard
POLAR_SERVER=sandbox           # sandbox | production
POLAR_SUCCESS_URL=http://localhost:3000/billing/success
# Product ids differ between the sandbox and production organisations.
POLAR_PRODUCT_SPRINT=
POLAR_PRODUCT_MONTH=
PLAN_CURRENCY=KZT              # display only; Polar charges in the product's currency

# ─── hh.ru OAuth client — see backend/app/hh/client_keys.py before changing ───
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=

# ─── LangSmith tracing — OFF by default on purpose ───
# Enabling it ships resumes, recruiter chats and test answers to a third party.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Otclick
