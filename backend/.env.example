# Supabase — local self-hosted stack (default, no cloud account needed).
# 1. Run: python3 infra/supabase/gen-keys.py
# 2. Paste the three printed lines (JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY) below.
# 3. Also copy ANON_KEY value into SUPABASE_ANON_KEY and SERVICE_ROLE_KEY into
#    SUPABASE_SERVICE_ROLE_KEY below (the app reads the SUPABASE_* names; the
#    compose services read the bare names — they share the same values).
# 4. Set POSTGRES_PASSWORD to any strong local secret.
SUPABASE_URL=http://kong:8000
# Same stack, but the host a browser can reach (signed captcha-screenshot URLs).
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# Google OAuth login — optional, off by default (no Google Cloud Console
# project needed to get started). Set to true + fill in the two vars below
# to enable the "continue with Google" button.
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption — generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-generated-fernet-key-here

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Internal cron — shared secret for /internal/cron/* (token-refresh).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CRON_TOKEN=
# Refresh hh creds expiring within this many days (single-use refresh token → near-expiry only)
REFRESH_THRESHOLD_DAYS=2

# OpenAI — cover letter generator (gpt-4o-mini ~$0.001/letter)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_RATE_LIMIT=60

# CloudPayments billing. PUBLIC_ID is sent to the widget (safe to expose);
# API_SECRET is the HMAC key verifying webhook authenticity — keep secret.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
PLAN_PRICE=999
PLAN_CURRENCY=RUB
PLAN_NAME=AI Autoclicker Pro
PLAN_INTERVAL=Month
PLAN_PERIOD=1

# hh.ru — local dev only, not used in production
HH_LOGIN=your_email_or_phone@example.com
HH_PASSWORD=your_password
HH_TEST_VACANCY_ID=


# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="Otclick"
